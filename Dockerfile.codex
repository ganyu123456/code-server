FROM codercom/code-server:latest
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    git-lfs \
    gnupg \
    htop \
    jq \
    locales \
    man-db \
    nano \
    net-tools \
    openssh-client \
    procps \
    python3 \
    python3-pip \
    sudo \
    unzip \
    vim \
    wget \
    zsh \
  && git lfs install \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://bun.sh/install | bash \
  && cp /root/.bun/bin/bun /usr/local/bin/bun \
  && cp /root/.bun/bin/bunx /usr/local/bin/bunx
RUN curl -fsSL https://opencode.ai/install | bash \
  || (bun install -g opencode-ai@latest)
RUN echo 'export PATH="$HOME/.bun/bin:$PATH"' >> /etc/profile.d/opencode.sh \
  && echo 'export PATH="$HOME/.bun/bin:$PATH"' >> /etc/bash.bashrc \
  && ln -sf /root/.opencode/bin/opencode /usr/local/bin/opencode 2>/dev/null \
  || ln -sf /root/.bun/bin/opencode /usr/local/bin/opencode 2>/dev/null \
  || true
COPY ai-agent.vsix /tmp/ai-agent.vsix
RUN mkdir -p /home/coder/.local/share/code-server/extensions \
  && chown -R coder:coder /home/coder/.local/share/code-server/extensions \
  && /usr/bin/code-server --install-extension /tmp/ai-agent.vsix --extensions-dir /home/coder/.local/share/code-server/extensions
RUN mkdir -p /home/coder/.config/code-server \
  && printf 'bind-addr: 0.0.0.0:8080\nauth: password\npassword: admin123\ncert: false\nextensions-dir: /home/coder/.local/share/code-server/extensions\n' > /home/coder/.config/code-server/config.yaml
RUN mkdir -p /home/coder/.local/share/code-server/User \
  && printf '{"chat.disableAIFeatures":true}\n' > /home/coder/.local/share/code-server/User/settings.json
RUN chown -R coder:coder /home/coder
EXPOSE 8080
USER 1000
ENV USER=coder
WORKDIR /home/coder
ENTRYPOINT ["/usr/bin/entrypoint.sh", "--bind-addr", "0.0.0.0:8080", "."]
